#include <graphics.h>
#include <conio.h>

int main()
{
    int gd = DETECT, gm;
    initgraph(&gd, &gm, "");

    int points[] = {
        150, 150,
        450, 150,
        350, 250,
        450, 350,
        150, 350,
        250, 250,
        150, 150
    };

    drawpoly(7, points);

    getch();
    closegraph();

    return 0;
}
