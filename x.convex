#include <graphics.h>
#include <conio.h>

int main()
{
    int gd = DETECT, gm;
    initgraph(&gd, &gm, "");

    int points[] = {
        200, 150,
        400, 150,
        450, 300,
        300, 400,
        150, 300,
        200, 150
    };

    drawpoly(6, points);

    getch();
    closegraph();

    return 0;
}
